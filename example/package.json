{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev-front": "bun --hot src/frontend.ts",
    "dev-back": "bun --hot src/backend.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "@spiko-tech/effect-react-query": "^2.0.0",
    "@tanstack/react-query": "^5.104.1",
    "effect": "4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
